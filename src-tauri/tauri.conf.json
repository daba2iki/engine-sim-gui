{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Engine Sim GUI",
  "version": "0.1.0",
  "identifier": "com.enginesim.gui",
  "build": {
    "beforeDevCommand": "vite dev",
    "beforeBuildCommand": "vite build",
    "distDir": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Engine Sim GUI",
        "width": 1200,
        "height": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "com.enginesim.gui"
  }
}
